# Measurements are kept locally; existing tracked files are unaffected.
/data/

# Local environment, archives and generated Python files.
/.venv/
/.local/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Credentials and machine-specific files.
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini

# Share only the project workspace settings from VS Code.
/.vscode/*
!/.vscode/settings.json

# Desktop build output
/desktop/dist/
/desktop/build/
/desktop/*.spec
/desktop/smoke_output/
/desktop/SignalScope.pkg
